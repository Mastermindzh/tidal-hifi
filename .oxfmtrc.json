{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "ts-dist",
    "dist",
    "build",
    "node_modules",
    "package-lock.json",
    "src/features/api/swagger.json",
    "scripts/verifyElements.js",
    "themes/*.css",
    "src/pages/settings/styles/settings.css"
  ],
  "sortImports": {
    "newlinesBetween": false,
    "groups": [
      "builtin",
      "external",
      {
        "newlinesBetween": true
      },
      ["parent", "sibling", "index"],
      "unknown"
    ]
  }
}
